class UserViewSet(viewsets.ModelViewSet):
    """
    Secure User API.

    READ ACCESS
    ----------
    ADMIN:
        Can view all users.

    MANAGER:
        Can view themselves and their direct reports.

    EMPLOYEE:
        Can view themselves only.

    WRITE ACCESS
    ------------
    ADMIN:
        Full user management.

    MANAGER:
        Cannot create, update, or delete users.

    EMPLOYEE:
        Cannot create, update, or delete users.

    ACCOUNT SECURITY
    ----------------
    ADMIN:
        Can activate/deactivate accounts through the dedicated
        set-active endpoint.

        Every activation-status change rotates token_version,
        invalidating all previously issued JWT sessions.
    """

    serializer_class = UserSerializer
    permission_classes = [permissions.IsAuthenticated]

    def get_queryset(self):
        user = self.request.user

        if user.role == "ADMIN":
            return User.objects.all().order_by("-date_joined")

        if user.role == "MANAGER":
            return User.objects.filter(
                Q(id=user.id)
                | Q(employee_profile__manager__user=user)
            ).distinct().order_by("-date_joined")

        return User.objects.filter(
            id=user.id
        ).order_by("-date_joined")

    def create(self, request, *args, **kwargs):
        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to create user accounts."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        return super().create(request, *args, **kwargs)

    def update(self, request, *args, **kwargs):
        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to update user accounts."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        return super().update(request, *args, **kwargs)

    def partial_update(self, request, *args, **kwargs):
        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to update user accounts."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        return super().partial_update(request, *args, **kwargs)

    def destroy(self, request, *args, **kwargs):
        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to delete user accounts."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        return super().destroy(request, *args, **kwargs)

    @action(
        detail=True,
        methods=["post"],
        url_path="set-active",
    )
    def set_active(self, request, pk=None):
        """
        Activate or deactivate a user account.

        ADMIN ONLY.

        Every status change increments token_version, which
        immediately invalidates previously issued JWT sessions.
        """

        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to activate or deactivate user accounts."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        target_user = self.get_object()

        if target_user == request.user:
            return Response(
                {
                    "detail": (
                        "Administrators cannot deactivate their own "
                        "account through this endpoint."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )

        if "is_active" not in request.data:
            return Response(
                {
                    "detail": (
                        "The 'is_active' field is required and must "
                        "be either true or false."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )

        new_status = request.data.get("is_active")

        if not isinstance(new_status, bool):
            return Response(
                {
                    "detail": (
                        "The 'is_active' field must be a boolean "
                        "value: true or false."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )

        if target_user.is_active == new_status:
            return Response(
                {
                    "detail": (
                        f"User account is already "
                        f"{'active' if new_status else 'inactive'}."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )

        previous_status = target_user.is_active

        target_user.is_active = new_status
        target_user.token_version += 1

        target_user.save(
            update_fields=[
                "is_active",
                "token_version",
            ]
        )

        forwarded_for = request.META.get("HTTP_X_FORWARDED_FOR")

        if forwarded_for:
            ip_address = forwarded_for.split(",")[0].strip()
        else:
            ip_address = request.META.get("REMOTE_ADDR")

        action_name = (
            "ACCOUNT_ACTIVATED"
            if new_status
            else "ACCOUNT_DEACTIVATED"
        )

        AuditLog.objects.create(
            user=request.user,
            action=action_name,
            ip_address=ip_address,
            description=(
                f"Administrator changed account status for "
                f"user '{target_user.username}'. "
                f"Previous status: "
                f"{'active' if previous_status else 'inactive'}. "
                f"New status: "
                f"{'active' if new_status else 'inactive'}. "
                f"All previously issued authentication sessions "
                f"were invalidated through token version rotation."
            ),
        )

        return Response(
            {
                "detail": (
                    f"User account successfully "
                    f"{'activated' if new_status else 'deactivated'}."
                ),
                "user_id": target_user.id,
                "username": target_user.username,
                "is_active": target_user.is_active,
                "token_version": target_user.token_version,
            },
            status=status.HTTP_200_OK,
        )



    @action(
        detail=True,
        methods=["post"],
        url_path="revoke-sessions",
    )
    def revoke_sessions(self, request, pk=None):
        """
        Revoke all currently issued authentication sessions
        for a target user.

        ADMIN ONLY.

        Incrementing token_version immediately invalidates
        previously issued JWT access and refresh tokens while
        keeping the target account active.
        """

        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to revoke user authentication sessions."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        target_user = self.get_object()

        if target_user == request.user:
            return Response(
                {
                    "detail": (
                        "Administrators cannot revoke their own "
                        "sessions through this endpoint."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )

        previous_token_version = target_user.token_version

        target_user.token_version += 1

        target_user.save(
            update_fields=[
                "token_version",
            ]
        )

        forwarded_for = request.META.get("HTTP_X_FORWARDED_FOR")

        if forwarded_for:
            ip_address = forwarded_for.split(",")[0].strip()
        else:
            ip_address = request.META.get("REMOTE_ADDR")

        AuditLog.objects.create(
            user=request.user,
            action="SESSIONS_REVOKED",
            ip_address=ip_address,
            description=(
                f"Administrator revoked all authentication sessions "
                f"for user '{target_user.username}'. "
                f"Token security version changed from "
                f"{previous_token_version} to "
                f"{target_user.token_version}. "
                "All previously issued JWT authentication sessions "
                "were invalidated."
            ),
        )

        return Response(
            {
                "detail": (
                    "All authentication sessions for the user "
                    "have been revoked successfully."
                ),
                "user_id": target_user.id,
                "username": target_user.username,
                "token_version": target_user.token_version,
            },
            status=status.HTTP_200_OK,
        )
    @action(
        detail=True,
        methods=["get"],
        url_path="sessions",
    )
    def sessions(self, request, pk=None):
        """
        Return security metadata for a user's outstanding JWT sessions.

        ADMIN ONLY.

        Actual refresh-token values are never returned.
        """

        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to view user authentication sessions."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        target_user = self.get_object()

        outstanding_tokens = (
            OutstandingToken.objects
            .filter(user=target_user)
            .order_by("-created_at")
        )

        session_data = []

        for token in outstanding_tokens:
            is_blacklisted = BlacklistedToken.objects.filter(
                token=token
            ).exists()

            session_data.append(
                {
                    "jti": str(token.jti),
                    "created_at": token.created_at,
                    "expires_at": token.expires_at,
                    "status": (
                        "BLACKLISTED"
                        if is_blacklisted
                        else "OUTSTANDING"
                    ),
                }
            )

        forwarded_for = request.META.get("HTTP_X_FORWARDED_FOR")

        if forwarded_for:
            ip_address = forwarded_for.split(",")[0].strip()
        else:
            ip_address = request.META.get("REMOTE_ADDR")

        AuditLog.objects.create(
            user=request.user,
            action="SESSIONS_VIEWED",
            ip_address=ip_address,
            description=(
                f"Administrator viewed authentication session "
                f"metadata for user '{target_user.username}'. "
                f"Session records returned: {len(session_data)}. "
                "Refresh-token values were not exposed."
            ),
        )

        return Response(
            {
                "user_id": target_user.id,
                "username": target_user.username,
                "sessions": session_data,
                "session_count": len(session_data),
            },
            status=status.HTTP_200_OK,
        )

    @action(
        detail=True,
        methods=["post"],
        url_path=r"sessions/(?P<jti>[0-9a-fA-F]+)/revoke",
    )
    def revoke_session(self, request, pk=None, jti=None):
        """
        Revoke one specific refresh-token session.

        ADMIN ONLY.

        The refresh-token value itself is never exposed or accepted.
        Only the token JTI is used to identify the session.
        """

        if request.user.role != "ADMIN":
            return Response(
                {
                    "detail": (
                        "Only Administrators are authorized "
                        "to revoke user authentication sessions."
                    )
                },
                status=status.HTTP_403_FORBIDDEN,
            )

        target_user = self.get_object()

        try:
            outstanding_token = OutstandingToken.objects.get(
                user=target_user,
                jti=jti,
            )
        except OutstandingToken.DoesNotExist:
            return Response(
                {
                    "detail": (
                        "The specified authentication session "
                        "was not found for this user."
                    )
                },
                status=status.HTTP_404_NOT_FOUND,
            )

        blacklisted_token, created = BlacklistedToken.objects.get_or_create(
            token=outstanding_token
        )

        forwarded_for = request.META.get("HTTP_X_FORWARDED_FOR")

        if forwarded_for:
            ip_address = forwarded_for.split(",")[0].strip()
        else:
            ip_address = request.META.get("REMOTE_ADDR")

        if created:
            action_name = "SESSION_REVOKED"
            description = (
                f"Administrator revoked authentication session "
                f"'{jti}' for user '{target_user.username}'. "
                "The associated refresh token was blacklisted."
            )
        else:
            action_name = "SESSION_REVOCATION_ATTEMPTED"
            description = (
                f"Administrator attempted to revoke authentication "
                f"session '{jti}' for user '{target_user.username}', "
                "but the session was already blacklisted."
            )

        AuditLog.objects.create(
            user=request.user,
            action=action_name,
            ip_address=ip_address,
            description=description,
        )

        return Response(
            {
                "detail": (
                    "Authentication session successfully revoked."
                    if created
                    else "Authentication session was already revoked."
                ),
                "user_id": target_user.id,
                "username": target_user.username,
                "jti": str(outstanding_token.jti),
                "status": "BLACKLISTED",
            },
            status=status.HTTP_200_OK,
        )
class PasswordChangeView(APIView):
    """
    Secure authenticated-user password change.

    Security requirements:
    - User must be authenticated.
    - Current password must be verified.
    - New password must match confirmation.
    - New password must differ from current password.
    - Django's configured password validators are enforced.
    """

    permission_classes = [permissions.IsAuthenticated]

    def post(self, request):
        user = request.user

        current_password = request.data.get("current_password")
        new_password = request.data.get("new_password")
        confirm_password = request.data.get("confirm_password")

        if not current_password or not new_password or not confirm_password:
            return Response(
                {
                    "detail": (
                        "current_password, new_password, and "
                        "confirm_password are required."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )

        if not user.check_password(current_password):
            return Response(
                {"detail": "The current password is incorrect."},
                status=status.HTTP_400_BAD_REQUEST,
            )

        if new_password != confirm_password:
            return Response(
                {"detail": "The new passwords do not match."},
                status=status.HTTP_400_BAD_REQUEST,
            )

        if current_password == new_password:
            return Response(
                {
                    "detail": (
                        "The new password must be different from "
                        "the current password."
                    )
                },
                status=status.HTTP_400_BAD_REQUEST,
            )

        try:
            validate_password(new_password, user)
        except ValidationError as exc:
            return Response(
                {"detail": list(exc.messages)},
                status=status.HTTP_400_BAD_REQUEST,
            )

        user.token_version += 1
        user.set_password(new_password)
        user.save(update_fields=["password", "token_version"])

        forwarded_for = request.META.get("HTTP_X_FORWARDED_FOR")
        if forwarded_for:
            ip_address = forwarded_for.split(",")[0].strip()
        else:
            ip_address = request.META.get("REMOTE_ADDR")

        AuditLog.objects.create(
            user=user,
            action="PASSWORD_CHANGED",
            ip_address=ip_address,
            description=(
                "User password changed successfully. "
                "All previously issued authentication sessions "
                "were invalidated through token version rotation."
            ),
        )

        return Response(
            {"detail": "Password changed successfully."},
            status=status.HTTP_200_OK,
        )





