        },
    }

    def handle(self, *args, **options):
        self.stdout.write(self.style.NOTICE("HRMS AUTHORIZATION SEED"))
        self.stdout.write("")

        with transaction.atomic():
            roles_created = 0
            roles_updated = 0
            permissions_created = 0
            permissions_updated = 0
            mappings_created = 0

            roles = {}

            for code, data in self.ROLES.items():
                role, created = Role.objects.update_or_create(
                    code=code,
                    defaults={
                        "name": data["name"],
                        "description": data["description"],
                        "is_system_role": data["is_system_role"],
                        "is_active": True,
                    },
                )

                roles[code] = role

                if created:
                    roles_created += 1
                else:
                    roles_updated += 1

            permissions = {}

            for code, (name, description, module) in self.PERMISSIONS.items():
                permission, created = Permission.objects.update_or_create(
                    code=code,
                    defaults={
                        "name": name,
                        "description": description,
                        "module": module,
                        "is_active": True,
                    },
                )

                permissions[code] = permission

                if created:
                    permissions_created += 1
                else:
                    permissions_updated += 1

            for role_code, permission_codes in self.ROLE_PERMISSIONS.items():
                role = roles[role_code]

                if "*" in permission_codes:
                    selected_permissions = permissions.values()
                else:
                    selected_permissions = (
                        permissions[code]
                        for code in permission_codes
                    )

                for permission in selected_permissions:
                    _, created = RolePermission.objects.get_or_create(
                        role=role,
                        permission=permission,
                    )

                    if created:
                        mappings_created += 1

        self.stdout.write("")
        self.stdout.write(
            self.style.SUCCESS(
                "Authorization catalogue synchronized successfully."
            )
        )
        self.stdout.write(
            f"Roles created: {roles_created}"
        )
        self.stdout.write(
            f"Roles updated: {roles_updated}"
        )
        self.stdout.write(
            f"Permissions created: {permissions_created}"
        )
        self.stdout.write(
            f"Permissions updated: {permissions_updated}"
        )
        self.stdout.write(
            f"Role-permission mappings created: {mappings_created}"
        )
        self.stdout.write("")
        self.stdout.write(
            self.style.WARNING(
                "Existing users and UserRole assignments were NOT modified."
            )
        )
        self.stdout.write(
            "The legacy User.role field remains untouched for compatibility."
        )
